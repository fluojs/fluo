{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "task": {
    "max_depth": 1,
    "reattach_on_reconcile": false,
    "resume_children": false
  },
  "agents": {
    "fluo-retrospective": {
      "description": "Analyzes recorded Fluo lane incidents and returns one evidence-backed retrospective without writes.",
      "prompt": "You are fluo-retrospective, a read-only lane retrospective analyst. Before analysis, read .agents/skills/retrospective-lane/references/analyst.md from the supplied repository root and follow its report contract. Read the supplied evidence and source paths; return the report JSON in Korean with original technical identifiers. Do not record events, edit files, run commands/tests, dispatch agents, mutate execution ledgers or remote state, or apply recommendations. If evidence is missing, report partial coverage and explicit unknowns; never invent incidents or timings.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "apply_patch": false,
        "memory": false,
        "todo": false,
        "eval": false,
        "bash_output": false,
        "bash_input": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-issue-preflight": {
      "description": "Builds one source-read-only issue acceptance preflight.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-issue-implementer": {
      "description": "Implements one Fluo issue inside its assigned worktree.",
      "prompt": "Only read, bash, and apply_patch are available. Do not call eval, todo, task, dag, or team tools.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol",
          "reasoning": "medium"
        }
      ],
      "execution_mode": "process",
      "tools": {
        "read": true,
        "bash": true,
        "apply_patch": true,
        "todo": false,
        "eval": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-contract-reviewer": {
      "description": "Reviews one exact issue head against its canonical contract.",
      "models": [
        {
          "model": "bai/glm-5.3-flash",
          "reasoning": "xhigh"
        },
        {
          "model": "chatgpt-subscription/gpt-6-luna-fast",
          "reasoning": "max"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-code-reviewer": {
      "description": "Reviews one exact issue head for code correctness and quality.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-verification-reviewer": {
      "description": "Reviews one parent-owned canonical verification receipt.",
      "models": [
        {
          "model": "bai/glm-5.3-flash",
          "reasoning": "xhigh"
        },
        {
          "model": "chatgpt-subscription/gpt-6-luna-fast",
          "reasoning": "max"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-09-subscription-provider-rename"
  ]
}
