{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "task": {
    "max_depth": 1,
    "reattach_on_reconcile": false,
    "resume_children": false
  },
  "agents": {
    "fluo-retrospective": {
      "description": "Analyzes recorded Fluo lane incidents and returns one evidence-backed retrospective without writes.",
      "prompt": "You are fluo-retrospective, a read-only lane retrospective analyst. Before analysis, read .agents/skills/retrospective-lane/references/analyst.md from the supplied repository root and follow its report contract. Read the supplied evidence and source paths; return the report JSON in Korean with original technical identifiers. Do not record events, edit files, run commands/tests, dispatch agents, mutate execution ledgers or remote state, or apply recommendations. If evidence is missing, report partial coverage and explicit unknowns; never invent incidents or timings.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "high"
        },
        {
          "model": "ccapi/claude-opus-5-5",
          "reasoning": "high"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "meta/muse-spark-1.3",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "apply_patch": false,
        "memory": false,
        "todo": false,
        "eval": false,
        "bash_output": false,
        "bash_input": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-issue-preflight": {
      "description": "Builds one source-read-only issue acceptance preflight.",
      "prompt": "You are fluo-issue-preflight. First read .agents/skills/issue-preflight/references/preflight.md from the supplied repository or checkout and follow it. Stay read-only; return the accepted preflight artifact without adding dispatch identity to its digest. The lead records your agent identity separately.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "high"
        },
        {
          "model": "ccapi/claude-opus-5-5",
          "reasoning": "high"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "meta/muse-spark-1.3",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-issue-implementer": {
      "description": "Implements one Fluo issue inside its assigned worktree.",
      "prompt": "You are fluo-issue-implementer. First read .agents/skills/issue-implement/references/implementer.md from the assigned worktree and follow it. Only read, bash, and apply_patch are available. Do not call eval, todo, task, dag, or team tools. Edit and commit only inside that worktree; never push or mutate remote state. Return the exact Result; the lead records your agent identity separately.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "medium"
        },
        {
          "model": "ccapi/claude-opus-5-5",
          "reasoning": "medium"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "opengateway/deepseek/deepseek-v4.1-flash-ultrafast",
          "reasoning": "high"
        }
      ],
      "execution_mode": "process",
      "tools": {
        "read": true,
        "bash": true,
        "apply_patch": true,
        "todo": false,
        "eval": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-contract-reviewer": {
      "description": "Reviews one exact issue head against its canonical contract.",
      "prompt": "You are fluo-contract-reviewer. First read .agents/skills/review-head/references/reviewers/contract.md from the supplied exact-head checkout and follow it. Stay read-only. Return its canonical reviewer JSON with agent: fluo-contract-reviewer and the supplied head and effective policy.",
      "models": [
        {
          "model": "opengateway/z-ai/glm-5.3-flash-ultrafast",
          "reasoning": "xhigh"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "ccapi/claude-sonnet-5-5",
          "reasoning": "high"
        },
        {
          "model": "chatgpt-subscription/gpt-6-luna-fast",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-code-reviewer": {
      "description": "Reviews one exact issue head for code correctness and quality.",
      "prompt": "You are fluo-code-reviewer. First read .agents/skills/review-head/references/reviewers/code.md from the supplied exact-head checkout and follow it. Stay read-only. Return its canonical reviewer JSON with agent: fluo-code-reviewer and the supplied head and effective policy.",
      "models": [
        {
          "model": "chatgpt-subscription/gpt-6.1-sol-fast",
          "reasoning": "high"
        },
        {
          "model": "ccapi/claude-opus-5-5",
          "reasoning": "high"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "opengateway/deepseek/deepseek-v4.1-flash-ultrafast",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    },
    "fluo-verification-reviewer": {
      "description": "Reviews one parent-owned canonical verification receipt.",
      "prompt": "You are fluo-verification-reviewer. First read .agents/skills/review-head/references/reviewers/verification.md from the supplied exact-head checkout and follow it. Stay read-only; never run checks. Return its canonical reviewer JSON with agent: fluo-verification-reviewer and the supplied head and effective policy.",
      "models": [
        {
          "model": "opengateway/z-ai/glm-5.3-flash-ultrafast",
          "reasoning": "xhigh"
        },
        {
          "model": "zai/glm-5.3",
          "reasoning": "high"
        },
        {
          "model": "ccapi/claude-sonnet-5-5",
          "reasoning": "high"
        },
        {
          "model": "chatgpt-subscription/gpt-6-luna-fast",
          "reasoning": "high"
        }
      ],
      "execution_mode": "in-process",
      "tools": {
        "read": true,
        "bash": false,
        "todo": true,
        "eval": false,
        "bash_output": false,
        "monitor": false,
        "task": false,
        "dag": false,
        "task_create": false,
        "task_get": false,
        "task_list": false,
        "task_update": false,
        "task_send": false,
        "task_output": false,
        "task_cancel": false,
        "team_create": false,
        "team_delete": false
      }
    }
  },
  "_migrations": [
    "2026-08-reasoning-unification",
    "2026-09-subscription-provider-rename"
  ]
}
