import assert from 'node:assert/strict';

import { Module } from '@fluojs/core';
import { getDtoBindingSchema } from '@fluojs/core/request-pipeline';
import { Controller, FromQuery, Get, RequestDto } from '@fluojs/http';
import { Test } from '@fluojs/testing';

class GreetingRequest {
  @FromQuery('display_name')
  name = '';
}

@Controller('/toolchain')
class ToolchainController {
  @Get('/')
  @RequestDto(GreetingRequest)
  greet(input: GreetingRequest) {
    return { name: input.name };
  }
}

@Module({ controllers: [ToolchainController] })
class ToolchainModule {}

export async function verifyGeneratedDtoBinding(): Promise<void> {
  assert.deepEqual(getDtoBindingSchema(GreetingRequest), [
    { metadata: { key: 'display_name', optional: undefined, source: 'query' }, propertyKey: 'name' },
  ]);

  const app = await Test.createApp({ rootModule: ToolchainModule });
  await withCleanup(async (defer) => {
    defer(() => app.close());
    const response = await app.request('GET', '/toolchain/').query('display_name', 'Ada').send();
    assert.equal(response.status, 200);
    assert.deepEqual(response.body, { name: 'Ada' });
  });
}

type Cleanup = () => unknown | Promise<unknown>;

async function withCleanup<T>(
  operation: (defer: (cleanup: Cleanup) => void) => T | Promise<T>,
): Promise<T> {
  const cleanups: Cleanup[] = [];
  const failures: unknown[] = [];
  let outcome:
    | { readonly kind: 'failure'; readonly error: unknown }
    | { readonly kind: 'success'; readonly value: T }
    | undefined;

  try {
    outcome = { kind: 'success', value: await operation((cleanup) => { cleanups.push(cleanup); }) };
  } catch (error) {
    failures.push(error);
    outcome = { kind: 'failure', error };
  } finally {
    for (const cleanup of cleanups.reverse()) {
      try {
        await cleanup();
      } catch (error) {
        failures.push(error);
      }
    }
  }

  if (failures.length === 1) throw failures[0];
  if (failures.length > 1) throw new AggregateError(failures, 'Operation and cleanup failed.');

  if (!outcome || outcome.kind === 'failure') throw outcome?.error;
  return outcome.value;
}
