{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2024"],
    "skipLibCheck": true,
    "allowJs": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
    ,"types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../../fixture/domain.d.mts"]
}
