{
  "version": 2,
  "hostChecks": [
    { "id": "runner-integration", "executable": "node", "argv": ["--test", "tooling/ci/verification-runner.docker-test.mjs"], "cwd": "." }
  ],
  "tasks": [
    { "id": "build", "runtime": "primary", "dependencies": [], "capabilities": ["install", "build", "runtime-bundle"], "inputs": [], "outputs": ["build.tar", "build.json", "runtime-floor.tar"],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "pnpm", "argv": ["build"], "cwd": "." },
        { "executable": "node", "argv": ["tooling/testing/node-runtime-floor.mjs", "--bundle", "--dist", "--output", ".artifacts/runtime-floor"], "cwd": "." },
        { "executable": "node", "argv": ["tooling/testing/node-runtime-floor.mjs", ".artifacts/runtime-floor/runtime-floor-exercise.mjs", "--self-test"], "cwd": "." }
      ] },
    { "id": "static", "runtime": "primary", "dependencies": ["build"], "capabilities": ["node-tests", "typecheck", "lint", "platform-governance", "changeset", "docs", "docs-package", "docs-release", "declaration-importers", "documentation-governance", "global-setup-contract", "manifest-lockfile", "package-dependency-closure", "source-copy-inventory", "isolated-benchmark"], "inputs": ["build.tar"], "outputs": ["docs-site"],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "pnpm", "argv": ["test:node"], "cwd": "." },
        { "executable": "pnpm", "argv": ["typecheck"], "cwd": "." },
        { "executable": "pnpm", "argv": ["lint"], "cwd": "." },
        { "executable": "pnpm", "argv": ["verify:platform-consistency-governance"], "cwd": "." },
        { "executable": "node", "argv": ["tooling/release/verify-changeset-release-lane.mjs", "--lane=stable", "--base-ref={baseSha}"], "cwd": "." },
        { "executable": "pnpm", "argv": ["verify:docs"], "cwd": "." },
        { "executable": "pnpm", "argv": ["docs:package"], "cwd": "." },
        { "executable": "pnpm", "argv": ["docs:release-check", "--require-clean"], "cwd": "." },
        { "executable": "pnpm", "argv": ["--dir", "tooling/benchmarks/http-comparison", "--ignore-workspace", "install", "--frozen-lockfile"], "cwd": ".", "when": "isolated-benchmark" },
        { "executable": "pnpm", "argv": ["--dir", "tooling/benchmarks/http-comparison", "--ignore-workspace", "typecheck"], "cwd": ".", "when": "isolated-benchmark" },
        { "executable": "pnpm", "argv": ["--dir", "tooling/benchmarks/http-comparison", "--ignore-workspace", "test"], "cwd": ".", "when": "isolated-benchmark" }
      ] },
    { "id": "packages-1", "runtime": "primary", "dependencies": ["build"], "capabilities": ["packages-1"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--shard=1/4", "--maxWorkers=1"], "cwd": "." }] },
    { "id": "packages-2", "runtime": "primary", "dependencies": ["build"], "capabilities": ["packages-2"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--shard=2/4", "--maxWorkers=1"], "cwd": "." }] },
    { "id": "packages-3", "runtime": "primary", "dependencies": ["build"], "capabilities": ["packages-3"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--shard=3/4", "--maxWorkers=1"], "cwd": "." }] },
    { "id": "packages-4", "runtime": "primary", "dependencies": ["build"], "capabilities": ["packages-4"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--shard=4/4", "--maxWorkers=1"], "cwd": "." }] },
    { "id": "tooling-1", "runtime": "primary", "dependencies": ["build"], "capabilities": ["tooling-1", "apps", "examples"], "inputs": ["build.tar"], "outputs": [],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "pnpm", "argv": ["vitest", "run", "--project", "apps", "--maxWorkers=1"], "cwd": "." },
        { "executable": "pnpm", "argv": ["vitest", "run", "--project", "examples", "--maxWorkers=1"], "cwd": "." },
        { "executable": "pnpm", "argv": ["vitest", "run", "--project", "tooling", "--shard=1/2", "--maxWorkers=1"], "cwd": "." }
      ] },
    { "id": "tooling-2", "runtime": "primary", "dependencies": ["build"], "capabilities": ["tooling-2"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["vitest", "run", "--project", "tooling", "--shard=2/2", "--maxWorkers=1"], "cwd": "." }] },
    { "id": "starters", "runtime": "primary", "dependencies": ["build"], "capabilities": ["generated-starters"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["--dir", "packages/cli", "sandbox:matrix"], "cwd": ".", "env": { "FLUO_CLI_SANDBOX_PROFILE": "full", "FLUO_CLI_SANDBOX_DEPENDENCIES": "locked" } }] },
    { "id": "studio", "runtime": "primary", "dependencies": ["build"], "capabilities": ["studio-browser"], "inputs": ["build.tar"], "outputs": [],
      "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "pnpm", "argv": ["--filter", "@fluojs/studio", "test:browser"], "cwd": "." }] },
    { "id": "compatibility-floor", "runtime": "compat24", "dependencies": [], "capabilities": ["compatibility-floor"], "inputs": [], "outputs": [],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "pnpm", "argv": ["build"], "cwd": "." },
        { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--maxWorkers=1"], "cwd": "." },
        { "executable": "pnpm", "argv": ["--dir", "packages/cli", "sandbox:matrix"], "cwd": ".", "env": { "FLUO_CLI_SANDBOX_PROFILE": "smoke", "FLUO_CLI_SANDBOX_DEPENDENCIES": "locked" } }
      ] },
    { "id": "compatibility-next", "runtime": "compat26", "dependencies": [], "capabilities": ["compatibility-next"], "inputs": [], "outputs": [],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "pnpm", "argv": ["build"], "cwd": "." },
        { "executable": "pnpm", "argv": ["vitest", "run", "--project", "packages", "--maxWorkers=1"], "cwd": "." },
        { "executable": "pnpm", "argv": ["--dir", "packages/cli", "sandbox:matrix"], "cwd": ".", "env": { "FLUO_CLI_SANDBOX_PROFILE": "smoke", "FLUO_CLI_SANDBOX_DEPENDENCIES": "locked" } }
      ] },
    { "id": "runtime-floor", "runtime": "runtimeFloor", "dependencies": ["build"], "capabilities": ["runtime-floor"], "inputs": ["runtime-floor.tar"], "outputs": [],
      "commands": [{ "executable": "node", "argv": ["tooling/testing/node-runtime-floor.mjs", ".artifacts/runtime-floor/runtime-floor-exercise.mjs"], "cwd": "." }] },
    { "id": "native-bun", "runtime": "primary", "dependencies": ["build"], "capabilities": ["bun-routing", "bun-drizzle"], "inputs": ["build.tar"], "outputs": [],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "bun", "argv": ["test", "tooling/native-runtime/platform-bun-native-conformance.test.mjs"], "cwd": ".", "runtimeVersion": "1.2.3" },
        { "executable": "bun", "argv": ["test", "tooling/native-runtime/drizzle-bun-conformance.test.mjs"], "cwd": ".", "runtimeVersion": "1.4.0" }
      ] },
    { "id": "native-web", "runtime": "primary", "dependencies": ["build"], "capabilities": ["deno-native", "web-portability", "native-cookies"], "inputs": ["build.tar"], "outputs": [],
      "commands": [
        { "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." },
        { "executable": "deno", "argv": ["check", "--no-lock", "--node-modules-dir=auto", "--config", "packages/platform-deno/deno/deno.json", "npm:@fluojs/platform-deno"], "cwd": ".", "runtimeVersion": "2.5.0" },
        { "executable": "deno", "argv": ["test", "--no-lock", "--config", "packages/platform-deno/deno/deno.json", "--allow-net", "--allow-read", "packages/platform-deno/deno/native-adapter.test.js"], "cwd": ".", "runtimeVersion": "2.5.0" },
        { "executable": "pnpm", "argv": ["vitest", "run", "packages/testing/src/portability/web-runtime-adapter-portability.test.ts", "--maxWorkers=1"], "cwd": "." },
        { "executable": "bun", "argv": ["test", "tooling/native-runtime/response-cookie-conformance.test.mjs"], "cwd": ".", "runtimeVersion": "1.4.0" },
        { "executable": "deno", "argv": ["test", "--allow-read", "tooling/native-runtime/response-cookie-conformance.test.mjs"], "cwd": ".", "runtimeVersion": "2.9.7" },
        { "executable": "node", "argv": ["--test", "tooling/native-runtime/cloudflare-workers-response-cookie-conformance.test.mjs"], "cwd": "." }
      ] },
    { "id": "packed", "runtime": "primary", "dependencies": ["build"], "capabilities": ["packed-consumers"], "inputs": ["build.tar"], "outputs": [], "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }, { "executable": "node", "argv": ["tooling/testing/duplicate-module-safety.mjs"], "cwd": "." }] }
  ],
  "scope": {
    "fullPrefixes": [".github/", "apps/", "docs/", "examples/", "tooling/"],
    "fullPaths": ["biome.json", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "tsconfig.tools.json", "vitest.config.ts"]
  },
  "companions": [
    { "id": "manifest-lockfile", "when": "package-manifest", "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }] },
    { "id": "declaration-importers", "when": "module-importer", "commands": [{ "executable": "pnpm", "argv": ["verify:public-export-tsdoc"], "cwd": "." }] },
    { "id": "source-copy-inventory", "when": "public-source", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] },
    { "id": "documentation-governance", "when": "documentation", "commands": [{ "executable": "pnpm", "argv": ["verify:docs"], "cwd": "." }] },
    { "id": "global-setup-contract", "when": "global-setup", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] },
    { "id": "package-dependency-closure", "when": "package-manifest", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] }
  ],
  "rules": [
    { "prefix": "packages/platform-deno/", "commands": [{ "executable": "node", "argv": ["tooling/scripts/run-workspace-build-closure.mjs", "@fluojs/platform-deno"], "cwd": "." }, { "executable": "deno", "argv": ["check", "--no-lock", "--node-modules-dir=auto", "--config", "packages/platform-deno/deno/deno.json", "npm:@fluojs/platform-deno"], "cwd": "." }, { "executable": "deno", "argv": ["test", "--no-lock", "--config", "packages/platform-deno/deno/deno.json", "--allow-net", "--allow-read", "packages/platform-deno/deno/native-adapter.test.js"], "cwd": "." }] },
    { "prefix": "packages/studio/", "commands": [{ "executable": "pnpm", "argv": ["--filter", "@fluojs/studio", "test:browser"], "cwd": "." }] },
    { "prefix": "packages/cli/src/new/", "commands": [{ "executable": "pnpm", "argv": ["--dir", "packages/cli", "sandbox:matrix"], "cwd": "." }] },
    { "prefix": "tooling/testing/duplicate-module-safety", "commands": [{ "executable": "pnpm", "argv": ["test:duplicate-module-safety"], "cwd": "." }] }
  ]
}
