{
  "version": 1,
  "scope": {
    "fullPrefixes": [".github/", "apps/", "docs/", "examples/", "tooling/"],
    "fullPaths": ["biome.json", "package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml", "tsconfig.base.json", "tsconfig.tools.json", "vitest.config.ts"]
  },
  "companions": [
    { "id": "manifest-lockfile", "when": "package-manifest", "commands": [{ "executable": "pnpm", "argv": ["install", "--frozen-lockfile"], "cwd": "." }] },
    { "id": "declaration-importers", "when": "module-importer", "commands": [{ "executable": "pnpm", "argv": ["verify:public-export-tsdoc"], "cwd": "." }] },
    { "id": "source-copy-inventory", "when": "public-source", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] },
    { "id": "documentation-governance", "when": "documentation", "commands": [{ "executable": "pnpm", "argv": ["verify:docs"], "cwd": "." }] },
    { "id": "global-setup-contract", "when": "global-setup", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] },
    { "id": "package-dependency-closure", "when": "package-manifest", "commands": [{ "executable": "pnpm", "argv": ["test:verify"], "cwd": "." }] }
  ],
  "rules": [
    { "prefix": "packages/platform-deno/", "commands": [{ "executable": "node", "argv": ["tooling/scripts/run-workspace-build-closure.mjs", "@fluojs/platform-deno"], "cwd": "." }, { "executable": "deno", "argv": ["check", "--no-lock", "--node-modules-dir=auto", "--config", "packages/platform-deno/deno/deno.json", "npm:@fluojs/platform-deno"], "cwd": "." }, { "executable": "deno", "argv": ["test", "--no-lock", "--config", "packages/platform-deno/deno/deno.json", "--allow-net", "--allow-read", "packages/platform-deno/deno/native-adapter.test.js"], "cwd": "." }] },
    { "prefix": "packages/studio/", "commands": [{ "executable": "pnpm", "argv": ["--filter", "@fluojs/studio", "test:browser"], "cwd": "." }] },
    { "prefix": "packages/cli/src/new/", "commands": [{ "executable": "pnpm", "argv": ["--dir", "packages/cli", "sandbox:matrix"], "cwd": "." }] }
  ]
}
