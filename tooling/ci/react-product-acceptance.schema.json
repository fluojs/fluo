{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluo.dev/schemas/react-product-acceptance-v1",
  "title": "Issue 3879 local or final product execution receipt",
  "type": "object",
  "required": ["version", "issue", "stage", "head", "source", "preflightSha256", "matrixSha256", "checks", "rows", "reliability", "measurements"],
  "properties": {
    "version": { "const": 1 },
    "issue": { "const": 3879 },
    "stage": { "enum": ["local", "final"] },
    "head": { "$ref": "#/$defs/head" },
    "preflightSha256": { "$ref": "#/$defs/digest" },
    "matrixSha256": { "$ref": "#/$defs/digest" },
    "source": {
      "type": "object",
      "required": ["head", "tree", "clean"],
      "properties": { "head": { "$ref": "#/$defs/head" }, "tree": { "$ref": "#/$defs/head" }, "clean": { "const": true } }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "head", "status", "command", "exitCode", "elapsedMs", "log"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "head": { "$ref": "#/$defs/head" },
          "status": { "const": "passed" },
          "command": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 },
          "elapsedMs": { "type": "number", "minimum": 0 },
          "log": { "$ref": "#/$defs/artifact" },
          "browserReport": { "$ref": "#/$defs/artifact" },
          "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
        }
      }
    },
    "rows": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object", "required": ["id", "verdict"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "verdict": { "enum": ["passed", "lead-owned-pending"] }
        }
      }
    },
    "reliability": {
      "type": "object", "required": ["correctness", "soak"],
      "properties": {
        "correctness": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/run" } },
        "soak": { "$ref": "#/$defs/run" }
      }
    },
    "measurements": {
      "type": "object",
      "required": ["originalHeads", "currentProductMeasurement", "limits", "references", "seams", "quality", "authentication", "correctness", "cleanup"],
      "properties": {
        "originalHeads": { "type": "object", "required": ["client", "server"],
          "properties": { "client": { "$ref": "#/$defs/head" }, "server": { "$ref": "#/$defs/head" } } },
        "currentProductMeasurement": { "const": false },
        "limits": { "type": "string", "minLength": 1 },
        "references": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
        "seams": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["path", "original", "originalHead", "currentSha256", "relation", "limits"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "original": { "$ref": "#/$defs/artifact" },
              "originalHead": { "$ref": "#/$defs/head" },
              "currentSha256": { "$ref": "#/$defs/digest" },
              "relation": { "enum": ["unchanged", "changed"] },
              "limits": { "type": "string", "minLength": 1 }
            }
          }
        },
        "quality": { "const": "passed" },
        "authentication": { "const": "passed" },
        "correctness": { "const": "passed" },
        "cleanup": { "const": "passed" }
      }
    }
  },
  "$defs": {
    "head": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifact": {
      "type": "object", "required": ["path", "sha256"],
      "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "run": {
      "allOf": [
        { "$ref": "#/$defs/artifact" },
        { "type": "object", "required": ["trace"], "properties": { "trace": { "$ref": "#/$defs/artifact" } } }
      ]
    }
  }
}
