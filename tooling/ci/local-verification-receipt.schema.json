{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluojs.dev/schemas/local-verification-receipt-v1.json",
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["root", "headSha", "treeSha", "baseRef", "baseSha", "mergeBase", "changedFilesDigest", "diffDigest", "clean", "worktreeStatusDigest"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mergeBase": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "changedFilesDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "diffDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clean": { "type": "boolean" },
        "worktreeStatusDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "type": "object",
  "required": ["version", "status", "identity", "environment", "commands", "logs", "manifestDigest", "planDigest", "startedAt", "completedAt", "limitations"],
  "properties": {
    "version": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "identity": { "$ref": "#/$defs/identity" },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "executable", "argv", "cwd", "exitCode", "signal", "spawnError", "startedAt", "finishedAt", "identityBefore", "identityAfter"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "executable": { "type": "string", "minLength": 1 },
          "argv": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "exitCode": { "type": ["integer", "null"] },
          "signal": { "type": ["string", "null"] },
          "spawnError": { "type": ["string", "null"] },
          "startedAt": { "type": "string", "format": "date-time" },
          "finishedAt": { "type": "string", "format": "date-time" },
          "identityBefore": { "$ref": "#/$defs/identity" },
          "identityAfter": { "$ref": "#/$defs/identity" }
        }
      }
    },
    "logs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["commandId", "path", "digest"],
        "properties": {
          "commandId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "environment": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
