{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluojs.dev/schemas/local-verification-receipt-v2.json",
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["root", "headSha", "treeSha", "baseRef", "baseSha", "mergeBase", "changedFilesDigest", "diffDigest", "clean", "worktreeStatusDigest"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseRef": { "type": "string", "minLength": 1 },
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "mergeBase": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "changedFilesDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "diffDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clean": { "const": true },
        "worktreeStatusDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "file": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "type": "object",
  "required": ["version", "status", "profile", "identity", "source", "environment", "imageIdentity", "environmentLockDigest", "manifestDigest", "planDigest", "hostChecks", "taskResults", "capabilityTasks", "logs", "artifacts", "startedAt", "completedAt"],
  "properties": {
    "version": { "const": 2 },
    "status": { "enum": ["passed", "failed"] },
    "reason": { "type": "string" },
    "profile": { "enum": ["pr", "extended"] },
    "identity": { "$ref": "#/$defs/identity" },
    "source": {
      "type": "object",
      "required": ["headSha", "treeSha", "baseSha"],
      "properties": {
        "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "treeSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "environment": { "type": "object" },
    "imageIdentity": {
      "type": "object",
      "required": ["key", "id"],
      "properties": {
        "key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "id": { "type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "environmentLockDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "taskResults": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "hostChecks": { "type": ["object", "null"] },
    "capabilityTasks": { "type": "object" },
    "logs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
