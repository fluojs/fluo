{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluo.dev/schemas/omo/lane-ledger-v2.schema.json",
  "title": "OMO canonical lane ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "run_id",
    "lane_id",
    "status",
    "created_by",
    "base_branch",
    "source",
    "merge_policy",
    "pr_merge_method",
    "authority_scope",
    "retry_policy",
    "execution",
    "confirmed_issues",
    "suggested_but_excluded",
    "backlog_candidates",
    "release_handoffs",
    "completed_issues",
    "issue_progress",
    "lanes",
    "dependency_graph",
    "root_main_sync"
  ],
  "properties": {
    "version": { "const": 2 },
    "run_id": {
      "type": "string",
      "pattern": "^(?!.*(?:\\.|\\.lock)$)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lane_id": {
      "type": "string",
      "pattern": "^(?!.*(?:\\.|\\.lock)$)[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "lane_plan_approval_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "done",
        "needs-human-check-terminal",
        "blocked-budget-exhausted",
        "blocked-maintainer-decision",
        "blocked-child-contract-error",
        "blocked-ledger-conflict",
        "blocked-terminal"
      ]
    },
    "created_by": { "const": "create-lane" },
    "base_branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "search_run_id", "search_ledger", "artifact_id", "sha256"],
      "properties": {
        "type": { "const": "search-issue" },
        "search_run_id": {
          "type": "string",
          "pattern": "^(?!.*(?:\\.|\\.lock)$)[A-Za-z0-9][A-Za-z0-9+._-]*$"
        },
        "search_ledger": {
          "type": "string",
          "pattern": "^\\.omo/search-issue/artifacts/(?:legacy/)?[A-Za-z0-9][A-Za-z0-9+._-]*\\.json$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^search:[A-Za-z0-9][A-Za-z0-9+._-]*$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "merge_policy": {
      "enum": [
        "developer-final",
        "supervisor-auto",
        "supervisor-with-human-escalation",
        "supervisor-full-auto"
      ]
    },
    "pr_merge_method": { "const": "squash" },
    "authority_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_creation",
        "pr_creation",
        "pr_merge",
        "cleanup_command_worktrees",
        "root_main_sync_ff_only",
        "publish_via_github_actions"
      ],
      "properties": {
        "issue_creation": { "const": false },
        "pr_creation": { "const": true },
        "pr_merge": { "const": true },
        "cleanup_command_worktrees": { "type": "boolean" },
        "root_main_sync_ff_only": { "type": "boolean" },
        "publish_via_github_actions": { "const": false }
      }
    },
    "retry_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retry_count_is_terminal",
        "max_same_failure_repeats",
        "max_wall_clock_minutes",
        "stop_on_child_contract_error"
      ],
      "properties": {
        "retry_count_is_terminal": { "type": "boolean" },
        "max_same_failure_repeats": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "max_wall_clock_minutes": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "stop_on_child_contract_error": { "const": true }
      },
      "oneOf": [
        {
          "properties": {
            "retry_count_is_terminal": { "const": true },
            "max_same_failure_repeats": { "type": "integer", "minimum": 1 },
            "max_wall_clock_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "properties": {
            "retry_count_is_terminal": { "const": false },
            "max_same_failure_repeats": { "type": "integer", "minimum": 1 },
            "max_wall_clock_minutes": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "properties": {
            "retry_count_is_terminal": { "const": false },
            "max_same_failure_repeats": { "type": "null" },
            "max_wall_clock_minutes": { "type": "null" }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "last_command", "last_updated"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "last_command": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        },
        "last_updated": {
          "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
        }
      }
    },
    "confirmed_issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "suggested_but_excluded": { "type": "array" },
    "backlog_candidates": { "type": "array" },
    "release_handoffs": { "type": "array" },
    "completed_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1 }
    },
    "issue_progress": { "type": "object" },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "queue",
          "current_issue",
          "status",
          "branch",
          "worktree",
          "pr",
          "retry_count"
        ],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "queue": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "integer", "minimum": 1 }
          },
          "current_issue": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              { "type": "null" }
            ]
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "in_review",
              "merged",
              "done",
              "needs-human-check-terminal",
              "blocked-budget-exhausted",
              "blocked-maintainer-decision",
              "blocked-child-contract-error",
              "blocked-ledger-conflict",
              "blocked-terminal"
            ]
          },
          "branch": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
              },
              { "type": "null" }
            ]
          },
          "worktree": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^\\.worktrees/[A-Za-z0-9][A-Za-z0-9._/-]*$"
              },
              { "type": "null" }
            ]
          },
          "pr": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "integer", "minimum": 1 },
              { "type": "null" }
            ]
          },
          "retry_count": { "type": "integer", "minimum": 0 }
          ,
          "current_blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signature", "evidence"],
            "properties": {
              "signature": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "dependency_graph": { "type": "object" },
    "root_main_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sha"],
      "properties": {
        "status": {
          "enum": ["not-started", "done", "skipped-authority", "blocked-dirty"]
        },
        "sha": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
