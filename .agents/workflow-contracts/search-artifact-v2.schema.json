{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fluo.dev/schemas/omo/search-artifact-v2.schema.json",
  "title": "OMO search artifact v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "artifact_id", "sha256", "search_run_id", "selected_issues"],
  "properties": {
    "version": { "const": 2 },
    "artifact_id": {
      "type": "string",
      "pattern": "^search:[A-Za-z0-9][A-Za-z0-9+._-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "search_run_id": {
      "type": "string",
      "pattern": "^(?!.*(?:\\.|\\.lock)$)[A-Za-z0-9][A-Za-z0-9+._-]*$"
    },
    "selected_issues": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
    }
  }
}
