{
  "name": "fluo",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20.19.3 <21 || >=22.2.0 <27"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@biomejs/biome": "^2.4.10",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.13.10",
    "typescript": "^6.0.2",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --if-present run build",
    "typecheck": "tsc -p tsconfig.tools.json --noEmit && tsc -p examples/tsconfig.json --noEmit && pnpm -r --filter './packages/*' --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "pnpm --filter @fluo/docs dev",
    "docs:dev:clean": "pnpm docs:clean && pnpm docs:dev",
    "docs:clean": "pnpm --filter @fluo/docs clean",
    "docs:build": "pnpm --filter @fluo/docs build",
    "docs:typecheck": "pnpm --filter @fluo/docs typecheck",
    "docs:sync-check": "node tooling/docs/verify-docs-locale-parity.mjs",
    "verify:docs": "pnpm docs:sync-check && pnpm docs:typecheck && pnpm docs:build",
    "bench:di-container": "node tooling/benchmarks/di-container/run.mjs",
    "bench:runtime-module-graph": "node tooling/benchmarks/runtime-module-graph/run.mjs",
    "lint": "biome lint && pnpm verify:public-export-tsdoc",
    "verify": "pnpm build && pnpm typecheck && pnpm lint && pnpm test",
    "changeset": "changeset",
    "version-packages": "node tooling/release/version-packages.mjs",
    "publish-packages": "changeset publish",
    "verify:changeset-release-lane": "node tooling/release/verify-changeset-release-lane.mjs",
    "verify:release-readiness": "node tooling/release/verify-release-readiness.mjs",
    "generate:release-readiness-drafts": "node tooling/release/verify-release-readiness.mjs --write-drafts",
    "verify:public-export-tsdoc": "node tooling/governance/verify-public-export-tsdoc.mjs",
    "verify:public-export-tsdoc:baseline": "node tooling/governance/verify-public-export-tsdoc.mjs --mode=full",
    "verify:platform-consistency-governance": "node tooling/governance/verify-platform-consistency-governance.mjs",
    "verify:search-issue-native": "vitest run tooling/governance/search-issue-native.test.ts",
    "verify:lane-ledger": "node tooling/governance/verify-lane-ledger.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "protobufjs"
    ],
    "overrides": {
      "@babel/core": "7.29.7",
      "body-parser": "2.3.0",
      "brace-expansion@1.1.12": "1.1.16",
      "brace-expansion@2.0.2": "2.1.4",
      "engine.io": "6.6.9",
      "fast-uri": "3.1.5",
      "find-my-way": "9.7.0",
      "ip-address": "10.3.1",
      "js-yaml@3.14.2": "3.15.1",
      "js-yaml@4.1.1": "4.3.1",
      "mongoose": "9.7.2",
      "postcss": "8.5.23",
      "protobufjs": "7.6.5",
      "qs": "6.15.2",
      "sharp": "0.35.0",
      "socket.io-parser": "4.2.7",
      "valibot": "1.4.2",
      "vite": "6.4.3",
      "ws": "8.21.1"
    }
  }
}
