{
  "name": "@fluojs/platform-nodejs",
  "description": "Raw Node.js HTTP adapter package for the Fluo runtime.",
  "keywords": [
    "fluo",
    "nodejs",
    "node",
    "http-adapter",
    "platform",
    "server"
  ],
  "version": "2.0.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluojs/fluo.git",
    "directory": "packages/platform-nodejs"
  },
  "engines": {
    "node": ">=24.0.0 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "internal": [
        "./dist/internal.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../tooling/scripts/clean-dist.mjs",
    "build": "pnpm exec babel src --extensions .ts --ignore 'src/**/*.test.ts','src/**/*.test-fixture.ts' --out-dir dist --config-file ../../tooling/babel/babel.config.cjs && pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run -c vitest.config.ts",
    "test:watch": "pnpm exec vitest -c vitest.config.ts"
  },
  "dependencies": {
    "@fluojs/http": "workspace:^",
    "@fluojs/runtime": "workspace:^"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
