{
  "name": "@fluojs/platform-nextjs",
  "description": "Fluo HTTP platform and decorator compiler integration for Next.js App Router and Pages Router.",
  "keywords": [
    "fluo",
    "nextjs",
    "app-router",
    "backend",
    "http-adapter"
  ],
  "version": "0.0.0",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluojs/fluo.git",
    "directory": "packages/platform-nextjs"
  },
  "engines": {
    "node": ">=20.19.3 <21 || >=22.2.0 <27"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./app-router": {
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js"
    },
    "./decorators-loader": "./decorators-loader.cjs",
    "./next-config": {
      "types": "./dist/next-config.d.ts",
      "import": "./dist/next-config.js"
    },
    "./pages-router": {
      "types": "./dist/pages-router.d.ts",
      "import": "./dist/pages-router.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "decorators-loader.cjs"
  ],
  "scripts": {
    "prebuild": "node ../../tooling/scripts/clean-dist.mjs",
    "build": "pnpm exec babel src --extensions .ts --ignore 'src/**/*.test.ts' --out-dir dist --config-file ../../tooling/babel/babel.config.cjs && pnpm exec tsc -p tsconfig.build.json",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run -c vitest.config.ts",
    "test:watch": "pnpm exec vitest -c vitest.config.ts"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@fluojs/http": "workspace:^"
  },
  "peerDependencies": {
    "@fluojs/runtime": ">=2.0.0 <3",
    "next": ">=16.0.0 <17"
  },
  "devDependencies": {
    "@fluojs/core": "workspace:*",
    "@fluojs/runtime": "workspace:*",
    "vitest": "^3.2.4"
  }
}
