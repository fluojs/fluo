{
  "name": "@fluojs/studio",
  "description": "Runtime-connected React devtool for Fluo apps with static diagnostics report compatibility.",
  "keywords": [
    "fluo",
    "studio",
    "diagnostics",
    "viewer",
    "module-graph",
    "devtools"
  ],
  "version": "1.0.8",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fluojs/fluo.git",
    "directory": "packages/studio"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "fluo-studio-viewer": "./dist/viewer-cli.js"
  },
  "fluo": {
    "declarationBuildDevDependencies": [
      "@fluojs/runtime"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./viewer": "./dist/index.html"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prebuild": "node ../../tooling/scripts/clean-dist.mjs",
    "build": "pnpm exec vite build && pnpm exec babel src/contracts.ts src/index.ts src/viewer-server.ts src/viewer-cli.ts --extensions .ts --out-dir dist --config-file ../../tooling/babel/babel.config.cjs && pnpm exec tsc -p tsconfig.build.json",
    "dev": "pnpm exec vite",
    "preview": "pnpm exec vite preview",
    "test:browser": "pnpm build && pnpm exec playwright test -c playwright.config.ts",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit && pnpm exec tsc -p playwright.tsconfig.json --noEmit",
    "test": "pnpm exec vitest run -c vitest.config.ts",
    "test:watch": "pnpm exec vitest -c vitest.config.ts"
  },
  "dependencies": {
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@fluojs/runtime": "workspace:^",
    "@fluojs-internal/tooling-vite": "workspace:^",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.9.0",
    "vitest": "^3.2.4"
  }
}
