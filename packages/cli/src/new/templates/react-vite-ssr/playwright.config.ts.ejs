const development = serverMode === 'dev' || serverMode === 'direct';
const serverCommand = serverMode === 'direct'
  ? 'fluo dev'
  : development ? <%= devCommandJson %> : <%= startCommandJson %>;

export default defineConfig({
  fullyParallel: false,
  outputDir: 'node_modules/.cache/playwright-results',
  testDir: './tests',
  timeout: 30_000,
  use: {
    baseURL: `http://127.0.0.1:${BROWSER_TEST_PORT}`,
    channel: 'chrome',
    headless: true,
  },
  webServer: {
    command: serverCommand,
    env: { PORT: String(BROWSER_TEST_PORT), FLUO_REACT_FORM_TEST_SERVER: '1' },
    gracefulShutdown: { signal: 'SIGTERM', timeout: 10_000 },
    reuseExistingServer: false,
    timeout: 30_000,
    url: `http://127.0.0.1:${BROWSER_TEST_PORT}${development ? '/src/entry-client.tsx' : '/products/sku-42'}`,
  },
  workers: 1,
});
