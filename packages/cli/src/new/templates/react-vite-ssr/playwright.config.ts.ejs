import { defineConfig } from '@playwright/test';

const BROWSER_TEST_PORT = Number(process.env.FLUO_REACT_STARTER_TEST_PORT ?? '43006');
const serverMode = process.env.FLUO_REACT_STARTER_SERVER_COMMAND;
const development = serverMode === 'dev' || serverMode === 'direct';
const reliability = process.env.FLUO_REACT_RELIABILITY === '1';
const serverCommand = serverMode === 'direct'
  ? 'fluo dev'
  : development ? <%= devCommandJson %> : <%= startCommandJson %>;

export default defineConfig({
  fullyParallel: false,
  outputDir: 'node_modules/.cache/playwright-results',
  testDir: './tests',
  testMatch: reliability ? 'long-session.spec.ts' : '**/*.spec.ts',
  testIgnore: reliability ? ['long-session-soak.spec.ts'] : [
    'long-session*.spec.ts',
    ...(process.env.FLUO_PRODUCT_ACCEPTANCE === '1' ? [] : ['product-authoring.spec.ts']),
  ],
  timeout: 30_000,
  use: {
    baseURL: `http://127.0.0.1:${BROWSER_TEST_PORT}`,
    ...(reliability ? {} : { channel: 'chrome' }),
    headless: true,
  },
  projects: reliability ? [
    { name: 'chromium', use: { browserName: 'chromium' } },
    { name: 'firefox', use: { browserName: 'firefox' } },
    { name: 'webkit', use: { browserName: 'webkit' } },
  ] : [{ name: 'chrome', use: { browserName: 'chromium' } }],
  webServer: {
    command: serverCommand,
    env: { PORT: String(BROWSER_TEST_PORT), FLUO_REACT_FORM_TEST_SERVER: '1' },
    gracefulShutdown: { signal: 'SIGTERM', timeout: 10_000 },
    reuseExistingServer: false,
    timeout: 30_000,
    url: `http://127.0.0.1:${BROWSER_TEST_PORT}${development ? '/src/entry-client.tsx' : '/products/sku-42'}`,
  },
  workers: 1,
});
