import {
  Link,
} from '@fluojs/react/client';
import { type ReactElement, useEffect, useId, useState } from 'react';
import { reactPageRoutes } from './generated/react-pages';

function PageCounter(): ReactElement {
  const [count, setCount] = useState(0);
  const [hydrated, setHydrated] = useState(false);
  useEffect(() => setHydrated(true), []);
  return <button disabled={!hydrated} onClick={() => setCount((value) => value + 1)} type='button'>Count: {count}</button>;
}

export function ProductPage({ sku, preview }: {
  readonly sku: string;
  readonly preview: boolean;
  readonly productName: string;
}): ReactElement {
  const identifier = useId();
  if (sku === 'render-error' && typeof window !== 'undefined'
    && Reflect.get(window, '__allowRenderRetry') !== true) {
    throw new Error('Starter destination render failed');
  }

  return (
    <section aria-label='Product page'>
      <h1>{`Catalog item ${sku}`}</h1>
      <p>{preview ? 'Preview mode' : 'Published mode'}</p>
      <p data-react-identifier id={identifier}>Shared hydration identifier</p>
      <PageCounter />
      <Link {...reactPageRoutes['GET /search SearchPageRouter show'].link({ q: 'catalog' })}>Search catalog</Link>
    </section>
  );
}

export default ProductPage;
