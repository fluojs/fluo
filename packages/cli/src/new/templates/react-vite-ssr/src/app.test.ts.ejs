import { Test } from '@fluojs/testing';
import { createElement } from 'react';
import { describe, expect, it } from 'vitest';

import { createAppModule } from './app';
import { ReactStarterEntryError, createReactPageRenderer } from './entry-server';
import type { CatalogObservation } from './catalog';

const VITE_MANIFEST = {
  'src/entry-client.tsx': {
    css: ['styles.css'],
    file: 'entry-client.js',
    isEntry: true,
    src: 'src/entry-client.tsx',
  },
  'src/entry-server.tsx': {
    file: 'entry-server.js',
    isEntry: true,
    src: 'src/entry-server.tsx',
  },
  'src/page.tsx': { file: 'page-product.js', src: 'src/page.tsx' },
  'src/page-search.tsx': { file: 'page-search.js', src: 'src/page-search.tsx' },
} as const;

function readHtml(body: unknown): string {
  if (body instanceof Uint8Array) {
    return new TextDecoder().decode(body);
  }
  return typeof body === 'string' ? body : JSON.stringify(body);
}

describe('React Vite SSR starter', () => {
  it('dispatches JSON search and guarded queue writes with request-scope cleanup', async () => {
    // Given: the actual generated HTTP routes, datasource and DTOs.
    const events: CatalogObservation[] = [];
    const AppModule = createAppModule({
      clientDirectory: new URL('../dist/client/', import.meta.url),
      navigationBuildId: createReactPageRenderer(VITE_MANIFEST).buildId,
      renderPage: createReactPageRenderer(VITE_MANIFEST),
      catalogControl: (event) => { events.push(event); },
    });
    const app = await Test.createApp({ rootModule: AppModule });
    await withCleanup(async (defer) => {
      defer(() => app.close());
      // When: a credentialed explicit JSON read and guarded negotiated POST reach HTTP.
      const read = await app.request('GET', '/catalog/background/search').query('q', 'Blue')
        .header('accept', 'application/json').send();
      const saved = await app.request('POST', '/catalog/background/queue/blue', {
        cookies: { editor: 'yes', csrf: 'catalog-demo-token' },
      })
        .header('host', 'localhost:3000').header('origin', 'http://localhost:3000')
        .header('Accept', 'application/vnd.fluo.form+json;v=1')
        .body({ intent: 'add', csrf: 'catalog-demo-token' }).send();
      const unauthorized = await app.request('POST', '/catalog/background/queue/green')
        .header('Accept', 'application/vnd.fluo.form+json;v=1')
        .body({ intent: 'add', csrf: 'catalog-demo-token' }).send();
      // Then: safe results preserve HTTP ownership and every matching request scope cleans up.
      expect(read.status).toBe(200);
      expect(read.body).toEqual({ rows: [{ sku: 'blue', name: 'Blue song' }], query: 'Blue' });
      expect(saved.status).toBe(200);
      expect(saved.body).toMatchObject({ version: 1, outcome: 'saved',
        destination: '/catalog/background', data: { sku: 'blue', queued: true, revision: 1 } });
      expect(unauthorized.status).toBe(401);
      const dto = events.filter((event) => event.phase === 'dto');
      expect(dto.map((event) => event.dto)).toEqual([true, true]);
      for (const event of dto) {
        expect(events.some((cleanup) => cleanup.phase === 'cleanup' && cleanup.scope === event.scope)).toBe(true);
      }
    });
  });
  it('loads the latest development component after HTTP DTO validation', async () => {
    let label = 'First component';
    const AppModule = createAppModule({
      clientDirectory: new URL('../public/', import.meta.url),
      navigationBuildId: createReactPageRenderer(VITE_MANIFEST).buildId,
      loadPage: async (_module, props) => createElement('h1', null, `${label} ${String(props['sku'] ?? '')}`),
      renderPage: createReactPageRenderer(VITE_MANIFEST),
    });
    const app = await Test.createApp({ rootModule: AppModule });

    await withCleanup(async (defer) => {
      defer(() => app.close());
      const first = await app.request('GET', '/products/sku-42').send();
      label = 'Updated component';
      const second = await app.request('GET', '/products/sku-42').send();
      const invalid = await app.request('GET', '/products/x').query('preview', 'maybe').send();

      expect(readHtml(first.body)).toContain('First component');
      expect(readHtml(second.body)).toContain('Updated component');
      expect(invalid.status).toBe(400);
    });
  });

  it('streams an HTTP-owned page with manifest-derived hydration assets', async () => {
    const AppModule = createAppModule({
      clientDirectory: new URL('../dist/client/', import.meta.url),
      navigationBuildId: createReactPageRenderer(VITE_MANIFEST).buildId,
      renderPage: createReactPageRenderer(VITE_MANIFEST),
    });
    const app = await Test.createApp({ rootModule: AppModule });

    await withCleanup(async (defer) => {
      defer(() => app.close());
      const response = await app.request('GET', '/products/sku-42').query('preview', 'true').send();
      const html = readHtml(response.body);

      expect(response.status).toBe(200);
      expect(response.headers['Content-Type']).toBe('text/html; charset=utf-8');
      expect(html).toContain('Catalog item sku-42');
      expect(html).toContain('Preview mode');
      expect(html).toContain('src="/assets/entry-client.js"');
      expect(html).toContain('href="/assets/styles.css"');
      expect(html).toContain('href="/products/sku-84?preview=false"');
    });
  });

  it('keeps route validation on the server DTO boundary', async () => {
    const AppModule = createAppModule({
      clientDirectory: new URL('../dist/client/', import.meta.url),
      navigationBuildId: createReactPageRenderer(VITE_MANIFEST).buildId,
      renderPage: createReactPageRenderer(VITE_MANIFEST),
    });
    const app = await Test.createApp({ rootModule: AppModule });

    await withCleanup(async (defer) => {
      defer(() => app.close());
      const response = await app.request('GET', '/products/x').query('preview', 'maybe').send();
      expect(response.status).toBe(400);
    });
  });

  it('serves two DTO-bound pages as HTML and approved navigation JSON', async () => {
    // Given: one generated app with the shared renderer and two distinct HTTP handlers.
    const AppModule = createAppModule({
      clientDirectory: new URL('../dist/client/', import.meta.url),
      navigationBuildId: createReactPageRenderer(VITE_MANIFEST).buildId,
      renderPage: createReactPageRenderer({
        ...VITE_MANIFEST,
        'src/page.tsx': { file: 'page-product.js', src: 'src/page.tsx' },
        'src/page-search.tsx': { file: 'page-search.js', src: 'src/page-search.tsx' },
      }),
    });
    const app = await Test.createApp({ rootModule: AppModule });

    await withCleanup(async (defer) => {
      defer(() => app.close());
      // When: direct GET and the protocol Accept resolve each handler through HTTP.
      const product = await app.request('GET', '/products/sku-42').query('preview', 'true').send();
      const search = await app.request('GET', '/search').query('q', 'catalog').send();
      const approved = await app.request('GET', '/search')
        .query('q', 'catalog')
        .header('Accept', 'application/vnd.fluo.react-navigation+json;v=2')
        .send();

      // Then: both documents transfer their selected page; navigation confirms the DTO value.
      expect(readHtml(product.body)).toContain('Catalog item sku-42');
      expect(readHtml(search.body)).toMatch(/<h1>Search:\s*(?:<!-- -->)?catalog<\/h1>/u);
      expect(approved.body).toMatchObject({
        version: 2,
        buildId: createReactPageRenderer(VITE_MANIFEST).buildId,
        url: '/search?q=catalog',
        destination: { module: './page-search.tsx', props: { query: 'catalog' } },
      });
      expect((await app.request('GET', '/search').query('q', 'x').send()).status).toBe(400);
    });
  });

  it('rejects a page absent from the built importer map before writing HTML', async () => {
    // Given: a valid client entry whose manifest omitted the search destination.
    const { ['src/page-search.tsx']: _missing, ...manifest } = VITE_MANIFEST;
    const AppModule = createAppModule({
      clientDirectory: new URL('../dist/client/', import.meta.url),
      navigationBuildId: createReactPageRenderer(manifest).buildId,
      renderPage: createReactPageRenderer(manifest),
    });
    const app = await Test.createApp({ rootModule: AppModule });

    await withCleanup(async (defer) => {
      defer(() => app.close());
      // When: HTTP matches the search handler but cannot build its client destination.
      const response = await app.request('GET', '/search').query('q', 'catalog').send();

      // Then: no partial SSR page commits before the HTTP-owned error response.
      expect(response.status).toBe(500);
      expect(response.headers['Content-Type']).not.toBe('text/html; charset=utf-8');
    });
  });

  it('rejects an incompatible Vite manifest with a machine-readable entry error', () => {
    try {
      createReactPageRenderer({});
      throw new TypeError('Expected createReactPageRenderer(...) to reject an incompatible manifest.');
    } catch (error) {
      expect(error).toBeInstanceOf(ReactStarterEntryError);
      if (error instanceof ReactStarterEntryError) {
        expect(error.code).toBe('react-starter-entry-incompatible');
      }
    }
  });
});

type Cleanup = () => unknown | Promise<unknown>;

async function withCleanup<T>(
  operation: (defer: (cleanup: Cleanup) => void) => T | Promise<T>,
): Promise<T> {
  const cleanups: Cleanup[] = [];
  const failures: unknown[] = [];
  let outcome:
    | { readonly kind: 'failure'; readonly error: unknown }
    | { readonly kind: 'success'; readonly value: T }
    | undefined;

  try {
    outcome = { kind: 'success', value: await operation((cleanup) => { cleanups.push(cleanup); }) };
  } catch (error) {
    failures.push(error);
    outcome = { kind: 'failure', error };
  } finally {
    for (const cleanup of cleanups.reverse()) {
      try {
        await cleanup();
      } catch (error) {
        failures.push(error);
      }
    }
  }

  if (failures.length === 1) throw failures[0];
  if (failures.length > 1) throw new AggregateError(failures, 'Operation and cleanup failed.');

  if (!outcome || outcome.kind === 'failure') throw outcome?.error;
  return outcome.value;
}
