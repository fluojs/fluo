import { createElement, useState } from 'react';

/** HTTP-selected QR/songs destination; the persistent shell owns the resource. */
export default function AdminPage({ page }: { readonly page: 'qr' | 'songs' }) {
  const [count, setCount] = useState(0);
  return createElement('section', { 'aria-label': `Admin ${page} page` },
    createElement('h1', null, page === 'qr' ? 'Admin QR' : 'Admin songs'),
    createElement('button', { type: 'button', onClick: () => setCount((value) => value + 1) }, `Page count: ${count}`),
  );
}
