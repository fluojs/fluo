import { readFile } from 'node:fs/promises';

import { Module } from '@fluojs/core';
import {
  Controller,
  FromBody,
  FromPath,
  FromQuery,
  Get,
  NotFoundException,
  Optional,
  Post,
  RequestDto,
  type RequestContext,
} from '@fluojs/http';
import {
  Path,
  PageMetadata,
  ReactModule,
  ReactNavigationPage,
  Router,
  type ReactPageRenderer,
} from '@fluojs/react';
import { IsIn, IsString, MinLength } from '@fluojs/validation';
import { createElement, type ReactElement } from 'react';

import { createCatalogRouter, type CatalogControl } from './catalog';

const ASSET_FILE_PATTERN = /^[a-zA-Z0-9._-]+\.(?:css|js|svg)$/u;

export type ReactViteAppModuleOptions = {
  readonly catalogControl?: CatalogControl;
  readonly clientDirectory?: URL;
  readonly navigationBuildId?: string;
  readonly loadPage?: (module: `./page${string}.tsx`, props: Record<string, unknown>) => Promise<ReactElement>;
  readonly renderPage?: ReactPageRenderer;
};

class ProductPageRequest {
  @MinLength(3)
  @IsString()
  @FromPath('sku')
  sku = '';

  @IsIn(['true', 'false'])
  @Optional()
  @FromQuery('preview')
  preview?: string;
}

class ProductUpdateRequest {
  @MinLength(3)
  @IsString()
  @FromBody('name')
  name = '';

  @MinLength(3)
  @IsString()
  @FromPath('sku')
  sku = '';
}

class SearchPageRequest {
  @MinLength(2)
  @IsString()
  @FromQuery('q')
  q = '';
}

class AssetRequest {
  @FromPath('file')
  file = '';
}

export function createAppModule(options: ReactViteAppModuleOptions = {}) {
  const productNames = new Map<string, string>();
  const renderPage: ReactPageRenderer = (...args) => {
    if (options.renderPage === undefined) {
      throw new Error('The inspection module has no configured page presentation.');
    }
    return options.renderPage(...args);
  };
  const catalog = createCatalogRouter(async (props, context) => {
    const page = options.loadPage
      ? await options.loadPage('./page-products.tsx', { ...props })
      : createElement((await import('./page-products')).default, { ...props });
    return ReactNavigationPage.create(page, { module: './page-products.tsx', props: { ...props } },
      props.sessionDemo ? undefined : { prefetch: 'public' });
  }, options.catalogControl);

  @Router('/products')
  class ProductPageRouter {
    @PageMetadata(({ request }) => ({
      title: `Catalog item ${request.params.sku}`,
      meta: [{ name: 'description', content: `Product ${request.params.sku}` }],
      links: [{ rel: 'canonical', href: request.url }],
    }))
    @Path('/:sku')
    @RequestDto(ProductPageRequest)
    async show(input: ProductPageRequest) {
      const props = {
        sku: input.sku,
        preview: input.preview === 'true',
        productName: productNames.get(input.sku) ?? `Catalog item ${input.sku}`,
      };
      const page = options.loadPage
        ? await options.loadPage('./page.tsx', props)
        : createElement((await import('./page')).ProductPage, props);
      return ReactNavigationPage.create(page, {
        module: './page.tsx',
        props,
      });
    }

    @Post('/:sku')
    @RequestDto(ProductUpdateRequest)
    update(input: ProductUpdateRequest, context: RequestContext): void {
      productNames.set(input.sku, input.name);
      context.response.redirect(303, `/products/${encodeURIComponent(input.sku)}`);
    }
  }

  @Router('/search')
  class SearchPageRouter {
    @PageMetadata(({ request }) => ({
      title: `Search: ${String(request.query.q ?? '')}`,
      meta: [{ name: 'description', content: 'Search catalog' }],
    }))
    @Path('/')
    @RequestDto(SearchPageRequest)
    async show(input: SearchPageRequest) {
      const props = { query: input.q };
      const page = options.loadPage
        ? await options.loadPage('./page-search.tsx', props)
        : createElement((await import('./page-search')).default, props);
      return ReactNavigationPage.create(page, {
        module: './page-search.tsx',
        props,
      });
    }
  }

  @Controller('/assets')
  class ViteAssetController {
    @Get('/:file')
    @RequestDto(AssetRequest)
    async serve(input: AssetRequest, context: RequestContext): Promise<Uint8Array> {
      if (!ASSET_FILE_PATTERN.test(input.file)) {
        throw new NotFoundException('Vite asset not found.');
      }

      try {
        if (options.clientDirectory === undefined) {
          throw new Error('The inspection module has no configured asset directory.');
        }
        const body = await readFile(new URL(input.file, options.clientDirectory));
        context.response.setHeader('Cache-Control', /-[a-zA-Z0-9_-]{6,}\.(?:js|css|svg)$/u.test(input.file)
          ? 'public, max-age=31536000, immutable'
          : 'public, max-age=300');
        context.response.setHeader(
          'Content-Type',
          input.file.endsWith('.svg')
            ? 'image/svg+xml'
            : input.file.endsWith('.css') ? 'text/css; charset=utf-8' : 'text/javascript; charset=utf-8',
        );
        return body;
      } catch (error) {
        if (error instanceof Error && 'code' in error && error.code === 'ENOENT') {
          context.response.setHeader('X-Fluo-Asset-Status', 'missing');
          throw new NotFoundException('Vite asset not found.', { cause: error });
        }
        throw error;
      }
    }
  }

  @Module({
    controllers: [ViteAssetController],
    imports: [ReactModule.forRoot({
      controllers: [ProductPageRouter, SearchPageRouter, catalog.router],
      providers: catalog.providers,
      middleware: catalog.middleware,
      ...(options.navigationBuildId === undefined ? {} : { navigationBuildId: options.navigationBuildId }),
      renderPage,
    })],
  })
  class AppModule {
    static readonly errorRepresentation = catalog.errorRepresentation;
    static readonly applicationOptions = { errorRepresentation: catalog.errorRepresentation };
  }

  return AppModule;
}

export const AppModule = createAppModule();
export const applicationOptions = AppModule.applicationOptions;
