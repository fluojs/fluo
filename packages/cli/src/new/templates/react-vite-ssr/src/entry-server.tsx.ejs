/// <reference types="vite/client" />
import {
  createReactServerEntry,
  type ReactPageRenderer,
} from '@fluojs/react';
import { createReactViteAssetManifest } from '@fluojs/react/vite';

import { ReactAppDocument, REACT_IDENTIFIER_PREFIX } from './react-app';

const developmentPages = import.meta.glob('./page*.tsx');
export const developmentPageModules = Object.keys(developmentPages);

export class ReactStarterEntryError extends Error {
  readonly code = 'react-starter-entry-incompatible' as const;

  constructor(readonly diagnostics: readonly string[]) {
    super(
      [
        'The React starter could not match its server and client entries.',
        'Check src/entry-server.tsx, src/entry-client.tsx, and vite.client.config.ts, then run the generated build script again.',
        ...diagnostics,
      ].join('\n'),
    );
    this.name = 'ReactStarterEntryError';
  }
}

export function createReactPageRenderer(manifest: unknown): ReactPageRenderer {
  const result = createReactViteAssetManifest({
    base: '/assets/',
    entries: {
      client: 'src/entry-client.tsx',
      server: 'src/entry-server.tsx',
    },
    identifierPrefix: REACT_IDENTIFIER_PREFIX,
    manifest,
  });

  if (!result.ok) {
    throw new ReactStarterEntryError(
      result.diagnostics.map((diagnostic) => `${diagnostic.code}: ${diagnostic.message}`),
    );
  }

  const assets = result.manifest;
  const renderPage: ReactPageRenderer = (page, context, _policies, initialPage) => {
    if (initialPage !== undefined && (!Object.hasOwn(developmentPages, initialPage.payload.destination.module)
      || !Object.hasOwn(assets.assetMap, `src/${initialPage.payload.destination.module.slice(2)}`))) {
      throw new ReactStarterEntryError([`No built client destination: ${initialPage.payload.destination.module}`]);
    }
    return createReactServerEntry(
      <ReactAppDocument
        initialPage={initialPage}
        page={page}
        route={{ params: context.request.params, url: context.request.url }}
        stylesheets={assets.css}
      />,
      assets.hydrationOptions,
    );
  };

  return renderPage;
}

export function createReactDevelopmentPageRenderer(): ReactPageRenderer {
  return (page, context, _policies, initialPage) => {
    if (initialPage !== undefined && !Object.hasOwn(developmentPages, initialPage.payload.destination.module)) {
      throw new ReactStarterEntryError([`No development client destination: ${initialPage.payload.destination.module}`]);
    }
    return createReactServerEntry(
      <ReactAppDocument
        initialPage={initialPage}
        page={page}
        route={{ params: context.request.params, url: context.request.url }}
        stylesheets={['/src/styles.css?direct']}
      />,
      {
        bootstrapModules: ['/@vite/client', '/src/entry-client-dev.ts'],
        identifierPrefix: REACT_IDENTIFIER_PREFIX,
      },
    );
  };
}
