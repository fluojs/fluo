import { Link } from '@fluojs/react/client';
import { type ReactElement, useEffect, useState } from 'react';

declare const __FLUO_BUILD_VARIANT__: string;

export default function SearchPage(props: Record<string, unknown>): ReactElement {
  const query = typeof props['query'] === 'string' ? props['query'] : '';
  const [count, setCount] = useState(0);
  const [variant, setVariant] = useState('');
  useEffect(() => setVariant(__FLUO_BUILD_VARIANT__), []);

  return (
    <main>
      <h1>Search: {query}</h1>
      <p>DTO-bound query: {query}</p>
      <p data-testid='build-variant'>Built variant: {variant}</p>
      <button onClick={() => setCount((value) => value + 1)} type='button'>Page count: {count}</button>
      <Link href='/products/sku-84?preview=false'>Open sku-84</Link>
    </main>
  );
}
