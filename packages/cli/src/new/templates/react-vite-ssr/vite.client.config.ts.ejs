import { fileURLToPath } from 'node:url';

import { defineConfig } from 'vite';

export default defineConfig({
  base: '/assets/',
  build: {
    emptyOutDir: true,
    manifest: true,
    outDir: process.env.FLUO_REACT_CLIENT_OUTDIR ?? 'dist/client',
    rolldownOptions: {
      input: {
        'entry-client': fileURLToPath(new URL('./src/entry-client.tsx', import.meta.url)),
        'entry-server': fileURLToPath(new URL('./src/entry-server.tsx', import.meta.url)),
      },
      output: {
        assetFileNames: '[name]-[hash][extname]',
        chunkFileNames: '[name]-[hash].js',
        entryFileNames: '[name]-[hash].js',
      },
    },
    target: 'es2022',
  },
  define: {
    __FLUO_RELIABILITY_TEST__: JSON.stringify(process.env.FLUO_REACT_RELIABILITY === '1'),
    __FLUO_BUILD_VARIANT__: JSON.stringify(process.env.FLUO_REACT_BUILD_VARIANT ?? 'A'),
  },
  plugins: [{
    name: 'fluo:client-manifest-server-entry',
    enforce: 'pre',
    transform(_code, id) {
      if (id.split('?', 1)[0] === fileURLToPath(new URL('./src/entry-server.tsx', import.meta.url))) {
        return 'export {}';
      }
    },
  }],
});
