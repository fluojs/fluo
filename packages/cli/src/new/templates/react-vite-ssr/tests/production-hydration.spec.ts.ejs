test('keeps native anchors usable before hydration', async ({ page }) => {
  const development = ['dev', 'direct'].includes(process.env.FLUO_REACT_STARTER_SERVER_COMMAND ?? '');
  const entryPattern = development
    ? /\/src\/entry-client-dev\.ts$/u
    : /\/assets\/entry-client-[^/]+\.js$/u;
  let releaseBootstrap = () => {};
  const held = new Promise<void>((resolve) => { releaseBootstrap = resolve; });
  let firstEntry = true;
  await page.route(entryPattern, async (route) => {
    if (firstEntry) {
      firstEntry = false;
      await held;
      // The original document must never bootstrap after native navigation.
      await route.abort('aborted');
      return;
    }
    await route.continue();
  });
  try {
    const entryRequest = page.waitForRequest((request) => entryPattern.test(new URL(request.url()).pathname));
    await page.goto('/products/sku-42?preview=true', { waitUntil: 'commit' });
    await entryRequest;
    await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();

    const document = page.waitForResponse((result) =>
      result.url().includes('/search?q=catalog') && result.request().isNavigationRequest());
    const destinationReady = page.waitForURL('**/search?q=catalog', { waitUntil: 'domcontentloaded' });
    await page.getByRole('link', { name: 'Search catalog' }).first().click({ noWaitAfter: true });
    expect((await document).status()).toBe(200);
    await destinationReady;
    await expect(page.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  } finally {
    releaseBootstrap();
    await page.unrouteAll({ behavior: 'wait' });
  }
});

