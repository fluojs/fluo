    const cssUpdate = socket.waitForEvent('framereceived', {
      predicate: ({ payload }) => String(payload).includes('"type":"update"'),
      timeout: 15_000,
    });
    const observerInstalled = page.waitForEvent('console', {
      predicate: (message) => message.text() === 'css-observer-installed',
      timeout: 15_000,
    });
    const styleChanged = page.evaluate(() => new Promise<string>((resolve) => {
      const observer = new MutationObserver(() => {
        const color = getComputedStyle(document.body).color;
        if (color === 'rgb(12, 34, 56)') {
          observer.disconnect();
          resolve(color);
        }
      });
      observer.observe(document.head, { attributes: true, characterData: true, childList: true, subtree: true });
      console.info('css-observer-installed');
    }));
    await observerInstalled;
    await writeFile(cssFile, originalCss.replace('#172033', '#0c2238'));
    await cssUpdate;
    expect(await styleChanged).toBe('rgb(12, 34, 56)');
    await expect(page.getByRole('button', { name: 'Count: 1' })).toBeVisible();
    expect(await page.evaluate(() => document.documentElement.dataset.hmrIdentity)).toBe('retained');
    expect(browserErrors).toEqual([]);

    const invalidPage = originalPage.replace('const identifier = useId();', 'const identifier = ;');
    expect(invalidPage).not.toBe(originalPage);
    const transformError = socket.waitForEvent('framereceived', {
      predicate: ({ payload }) => String(payload).includes('"type":"error"'),
      timeout: 15_000,
    });
    await writeFile(pageFile, invalidPage);
    await transformError;
    await expect(page.locator('vite-error-overlay')).toBeVisible();
    expect(await page.evaluate(() => document.documentElement.dataset.hmrIdentity)).toBe('retained');
    const recovered = socket.waitForEvent('framereceived', {
      predicate: ({ payload }) => String(payload).includes('"type":"update"'),
      timeout: 15_000,
    });
    await writeFile(pageFile, originalPage.replace('Catalog item ${sku}', 'Recovered catalog item ${sku}'));
    await recovered;
    await expect(page.getByRole('heading', { name: 'Recovered catalog item sku-42' })).toBeVisible();
    await expect(page.getByRole('button', { name: 'Count: 1' })).toBeVisible();
    expect(await page.evaluate(() => document.documentElement.dataset.hmrIdentity)).toBe('retained');
    const latestPage = await page.request.get('/products/sku-42?preview=true');
    expect(await latestPage.text()).toContain('Recovered catalog item sku-42');
    const invalid = await page.request.get('/products/x?preview=maybe');
    expect(invalid.status()).toBe(400);
  } finally {
    await Promise.all([writeFile(pageFile, originalPage), writeFile(cssFile, originalCss)]);
  }
});

test('retains the document and worker through server restart and failed-bootstrap correction', async ({ page }) => {
  test.setTimeout(60_000);
  test.skip(!['dev', 'direct'].includes(process.env.FLUO_REACT_STARTER_SERVER_COMMAND ?? ''), 'Server recovery is development only.');
  const file = new URL('../src/app.ts', import.meta.url);
  const original = await readFile(file, 'utf8');
  const changed = original.replace("preview: input.preview === 'true'", "preview: input.preview !== 'false'");
  expect(changed).not.toBe(original);
  const invalid = changed.replace('const props = {', 'const props = ;');
  expect(invalid).not.toBe(changed);

  await page.goto('/products/sku-42');
  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
  const documentHandle = await page.evaluateHandle(() => document);
  const worker = await page.evaluateHandle(() => {
    const url = URL.createObjectURL(new Blob([
      'let count = 0; self.onmessage = () => self.postMessage(++count);',
    ], { type: 'text/javascript' }));
    const instance = new Worker(url);
    URL.revokeObjectURL(url);
    return instance;
  });
  const acknowledge = () => worker.evaluate((instance) => new Promise<number>((resolve) => {
    instance.onmessage = (event: MessageEvent<number>) => resolve(event.data);
    instance.postMessage('ack');
  }));
  const status = (expected: string) => {
    const registered = page.waitForEvent('console', {
      predicate: (message) => message.text() === `listening:${expected}`,
      timeout: 15_000,
    });
    const observed = page.evaluate((wanted) => new Promise<{ status: string; generation: number }>((resolve) => {
      window.addEventListener('fluo:server-status', (event) => {
        const message = (event as CustomEvent<{ status: string; generation: number }>).detail;
        if (message.status === wanted) resolve(message);
      });
      console.info(`listening:${wanted}`);
    }), expected);
    return { registered, observed };
  };

  try {
    expect(await acknowledge()).toBe(1);
    const restart = status('restarting');
    const ready = status('ready');
    await Promise.all([restart.registered, ready.registered]);
    await writeFile(file, changed);
    const first = await restart.observed;
    const second = await ready.observed;
    expect(second.generation).toBe(first.generation);
    expect(await documentHandle.evaluate((doc) => doc === document)).toBe(true);
    expect(await acknowledge()).toBe(2);
    expect(await (await page.request.get('/products/sku-42')).text()).toContain('Preview mode');

    const failing = status('failed');
    await failing.registered;
    await writeFile(file, invalid);
    await failing.observed;
    await expect(page.locator('[data-fluo-dev-status][role="status"]')).toContainText('fix the source');
    const unavailable = await page.request.get('/products/sku-42');
    expect(unavailable.status()).toBe(503);
    expect(unavailable.headers()['retry-after']).toBe('1');

    const recovered = status('ready');
    await recovered.registered;
    await writeFile(file, original);
    await recovered.observed;
    await expect(page.locator('[data-fluo-dev-status][role="status"]')).toHaveCount(0);
    expect(await documentHandle.evaluate((doc) => doc === document)).toBe(true);
    expect(await acknowledge()).toBe(3);
    expect(await (await page.request.get('/products/sku-42')).text()).toContain('Published mode');
  } finally {
    await writeFile(file, original);
    await worker.evaluate((instance) => instance.terminate()).catch(() => undefined);
    await worker.dispose();
    await documentHandle.dispose();
  }
});

