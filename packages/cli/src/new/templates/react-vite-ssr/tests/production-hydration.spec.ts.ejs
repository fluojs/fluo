    stdio: ['ignore', 'pipe', 'pipe'],
  });
  const ready: Array<{ resolve(): void; reject(error: Error): void }> = [];
  let stdout = '';
  let stderr = '';
  let lines = '';
  const exited = new Promise<number | null>((resolve) => child.once('close', (code) => {
    for (const waiter of ready.splice(0)) waiter.reject(new Error(`fluo dev exited before readiness: ${String(code)}\n${stdout}\n${stderr}`));
    resolve(code);
  }));
  child.stdout.on('data', (chunk: Buffer) => {
    stdout += String(chunk);
    lines += String(chunk);
    let end = lines.indexOf('\n');
    while (end >= 0) {
      const line = lines.slice(0, end);
      lines = lines.slice(end + 1);
      if (line.includes('React dev app ready')) ready.shift()?.resolve();
      end = lines.indexOf('\n');
    }
  });
  child.stderr.on('data', (chunk: Buffer) => { stderr += String(chunk); });
  const nextReady = () => new Promise<void>((resolve, reject) => { ready.push({ resolve, reject }); });
  try {
    const started = nextReady();
    await started;
    const url = `http://127.0.0.1:${address.port}/products/sku-42`;
    expect((await fetch(url)).status).toBe(200);
    for (const [index, file] of files.entries()) {
      const original = originals[index];
      if (original === undefined) throw new Error('Expected the generated configuration file.');
      const restarted = nextReady();
      await writeFile(file, `${original}\n${index === 0 ? '#' : '//'} issue3877-reload-${index}\n`);
      await restarted;
      expect((await fetch(url)).status).toBe(200);
    }
  } finally {
    await Promise.all(files.map((file, index) => writeFile(file, originals[index] ?? '')));
    if (child.pid && child.exitCode === null) process.kill(-child.pid, 'SIGTERM');
    const code = await exited;
    expect(code, `${stdout}\n${stderr}`).toBe(0);
    await expect(fetch(`http://127.0.0.1:${address.port}/products/sku-42`)).rejects.toThrow();
    await rm(root, { recursive: true, force: true });
  }
});
