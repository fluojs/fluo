test('keeps modified links as native new-tab documents', async ({ page }) => {
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();

  const popupPromise = page.waitForEvent('popup');
  const documentResponse = page.context().waitForEvent('response', {
    predicate: (response) =>
      response.url().includes('/search?q=catalog') && response.request().isNavigationRequest(),
  });
  await page.getByRole('link', { name: 'Open search in new tab' }).click();
  const popup = await popupPromise;
  const approvedDocument = await documentResponse;
  await expect(popup.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  expect(approvedDocument.status()).toBe(200);
  const modifiedPopupPromise = page.context().waitForEvent('page');
  await page.getByRole('link', { name: 'Search catalog' }).first().click({ modifiers: ['ControlOrMeta'] });
  const modifiedPopup = await modifiedPopupPromise;
  await expect(modifiedPopup.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  await expect(page).toHaveURL(/\/products\/sku-42\?preview=true$/u);
  await modifiedPopup.close();
});

test('keeps native anchors usable before hydration', async ({ page }) => {
  const development = ['dev', 'direct'].includes(process.env.FLUO_REACT_STARTER_SERVER_COMMAND ?? '');
  const entryPath = development ? '/src/entry-client-dev.ts' : '/assets/entry-client.js';
  let releaseBootstrap = () => {};
  const held = new Promise<void>((resolve) => { releaseBootstrap = resolve; });
  let firstEntry = true;
  await page.route(`**${entryPath}`, async (route) => {
    if (firstEntry) {
      firstEntry = false;
      await held;
      // The original document must never bootstrap after native navigation.
      await route.abort('aborted');
      return;
    }
    await route.continue();
  });
  try {
    const entryRequest = page.waitForRequest((request) => new URL(request.url()).pathname === entryPath);
    await page.goto('/products/sku-42?preview=true', { waitUntil: 'commit' });
    await entryRequest;
    await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();

    const document = page.waitForResponse((result) =>
      result.url().includes('/search?q=catalog') && result.request().isNavigationRequest());
    const destinationReady = page.waitForURL('**/search?q=catalog', { waitUntil: 'domcontentloaded' });
    await page.getByRole('link', { name: 'Search catalog' }).first().click({ noWaitAfter: true });
    expect((await document).status()).toBe(200);
    await destinationReady;
    await expect(page.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  } finally {
    releaseBootstrap();
    await page.unrouteAll({ behavior: 'wait' });
  }
});

test('falls back to a native document for an unsupported destination', async ({ page }) => {
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
  const rejected = page.waitForResponse((result) =>
    result.url().endsWith('/not-built')
    && result.request().headers()['accept'] === 'application/vnd.fluo.react-navigation+json;v=1');
  const document = page.waitForResponse((result) =>
    result.url().endsWith('/not-built') && result.request().isNavigationRequest());
  await page.getByRole('link', { name: 'Missing page' }).click();
  expect((await rejected).status()).toBe(404);
  expect((await document).status()).toBe(404);
  await expect(page).toHaveURL(/\/not-built$/u);
});
