test('opens modified links as native documents without replacing the current page', async ({ page }) => {
  await page.goto('/products/sku-42?preview=true');
  const counter = page.getByRole('button', { name: 'Count: 0' });
  await expect(counter).toBeEnabled();
  await counter.click();
  await expect(page.getByRole('button', { name: 'Count: 1' })).toBeVisible();

  const link = page.getByRole('link', { name: 'Open sku-84' });
  await expect(link).toHaveAttribute('href', '/products/sku-84?preview=false');
  const approvedDocument = await page.request.get('/products/sku-84?preview=false', {
    headers: { accept: 'text/html' },
  });
  expect(approvedDocument.status()).toBe(200);
  expect(approvedDocument.headers()['content-type']).toContain('text/html');
  // Native modifier tabs can finish their initial request before Playwright attaches.
  const [opened] = await Promise.all([
    page.context().waitForEvent('page', { timeout: 10_000 }),
    link.click({ modifiers: ['ControlOrMeta'] }),
  ]);
  await expect(opened).toHaveURL(/\/products\/sku-84\?preview=false$/u);
  await expect(opened.getByRole('heading', { name: 'Catalog item sku-84' })).toBeVisible();
  await expect(page).toHaveURL(/\/products\/sku-42\?preview=true$/u);
  await expect(page.getByRole('button', { name: 'Count: 1' })).toBeVisible();
  await opened.close();
});

test('hydrates two DTO pages and preserves the shell during HTTP-approved navigation', async ({ page }) => {
  const development = ['dev', 'direct'].includes(process.env.FLUO_REACT_STARTER_SERVER_COMMAND ?? '');
  const browserDiagnostics: string[] = [];
  const assetResponses = new Map<string, number>();

  page.on('console', (message) => {
    if (message.type() === 'error' || message.type() === 'warning') {
      browserDiagnostics.push(`${message.type()}: ${message.text()}`);
    }
  });
  page.on('pageerror', (error) => browserDiagnostics.push(`pageerror: ${error.message}`));
  page.on('response', (response) => {
    const pathname = new URL(response.url()).pathname;
    if (pathname.startsWith('/assets/') || pathname.startsWith('/src/') || pathname.startsWith('/@vite/')) {
      assetResponses.set(pathname, response.status());
    }
  });

  const response = await page.goto('/products/sku-42?preview=true', { waitUntil: 'load' });
  if (response === null) {
    throw new TypeError('The production page did not return a navigation response.');
  }

  const bootstrapPaths = await page.locator('script[type="module"][src]').evaluateAll((scripts) =>
    scripts.map((script) => new URL(script.getAttribute('src') ?? '', document.baseURI).pathname),
  );
  const stylesheetPaths = await page.locator('link[data-vite-style][href]').evaluateAll((links) =>
    links.map((link) => new URL(link.getAttribute('href') ?? '', document.baseURI).pathname),
  );

  expect(response.status()).toBe(200);
  expect(await response.text()).toMatch(/<button[^>]*disabled=""/u);
  expect(response.headers()['content-type']).toContain('text/html');
  expect(response.headers()['content-security-policy']).toContain("default-src 'self'");
  expect(response.headers()['content-security-policy']).toContain(development
    ? "style-src 'self' 'unsafe-inline'"
    : "default-src 'self'");
  if (development) {
    expect(response.headers()['content-security-policy']).toContain("worker-src 'self' blob:");
    const workerResult = await page.evaluate(() => new Promise<string>((resolve, reject) => {
      const source = URL.createObjectURL(new Blob(['self.postMessage("ready")'], { type: 'text/javascript' }));
      const worker = new Worker(source);
      worker.onmessage = (event) => {
        worker.terminate();
        URL.revokeObjectURL(source);
        resolve(String(event.data));
      };
      worker.onerror = (error) => {
        worker.terminate();
        URL.revokeObjectURL(source);
        reject(new Error(error.message));
      };
    }));
    expect(workerResult).toBe('ready');
  }
  if (!development) {
    expect(response.headers()['content-security-policy']).not.toContain("'unsafe-inline'");
    expect(response.headers()['content-security-policy']).not.toContain('worker-src');
  }
  await expect(page.locator('link[rel="icon"]')).toHaveAttribute('href', '/assets/favicon.svg');
  const favicon = await page.request.get('/assets/favicon.svg');
  expect(favicon.status()).toBe(200);
  expect(favicon.headers()['content-type']).toContain('image/svg+xml');
  expect(favicon.headers()['cache-control']).not.toContain('immutable');
  expect(bootstrapPaths).toEqual(expect.arrayContaining(
    development ? ['/src/entry-client-dev.ts'] : [expect.stringMatching(/^\/assets\/entry-client-[a-zA-Z0-9_-]+\.js$/u)],
  ));
  if (!development) {
    expect(bootstrapPaths).not.toContain('/@vite/client');
    expect(bootstrapPaths).not.toContain('/src/entry-client-dev.ts');
  }
  expect(stylesheetPaths).toHaveLength(1);
  for (const pathname of [...bootstrapPaths, ...stylesheetPaths]) {
    expect(assetResponses.get(pathname)).toBe(200);
  }

  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
  await page.getByRole('button', { name: 'Shell taps: 0' }).click();
  await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
  await page.getByRole('button', { name: 'Count: 0', exact: true }).click();
  await expect(page.getByRole('button', { name: 'Count: 1', exact: true })).toBeVisible();

  const link = page.getByRole('link', { name: 'Search catalog' }).first();
  const searchApproval = page.waitForResponse((result) =>
    result.url().includes('/search?q=catalog')
    && result.request().headers()['accept'] === 'application/vnd.fluo.react-navigation+json;v=2');
  await link.click();
  const approvedSearch = await searchApproval;
  expect(approvedSearch.status()).toBe(200);
  await expect(page).toHaveURL(/\/search\?q=catalog$/u);
  await expect(page.getByRole('heading', { name: 'Search: catalog' }), browserDiagnostics.join('\n')).toBeVisible();
  await expect(page.getByLabel('Current route')).toContainText('/search?q=catalog ({})');
  await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Page count: 0' })).toBeVisible();

  const productApproval = page.waitForResponse((result) =>
    result.url().includes('/products/sku-84?preview=false')
    && result.request().headers()['accept'] === 'application/vnd.fluo.react-navigation+json;v=2');
  const productLink = page.getByRole('link', { name: 'Open sku-84' }).first();
  await expect(productLink).toHaveAttribute('href', '/products/sku-84?preview=false');
  await productLink.click();
  expect((await productApproval).status()).toBe(200);
  await expect(page).toHaveURL(/\/products\/sku-84\?preview=false$/u);
  await expect(page.getByRole('heading', { name: 'Catalog item sku-84' })).toBeVisible();
  await expect(page.getByLabel('Current route')).toContainText('/products/sku-84?preview=false ({"sku":"sku-84"})');
  await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeVisible();

  const pushedApproval = page.waitForResponse((result) =>
    result.url().includes('/products/sku-126?preview=true')
    && result.request().headers()['accept'] === 'application/vnd.fluo.react-navigation+json;v=2');
  await page.getByRole('button', { name: 'Push sku-126' }).click();
  expect((await pushedApproval).status()).toBe(200);
  await expect(page).toHaveURL(/\/products\/sku-126\?preview=true$/u);
  await expect(page.getByRole('heading', { name: 'Catalog item sku-126' })).toBeVisible();
  expect(browserDiagnostics).toEqual([]);
});

test('retains the approved page and metadata while an HTTP destination is pending', async ({ page }) => {
  // Given: the negotiated search request is deferred before approval.
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
  await page.getByRole('button', { name: 'Shell taps: 0' }).click();
  let release = () => {};
  const deferred = new Promise<void>((resolve) => { release = resolve; });
  await page.route('**/search?q=catalog', async (route) => {
    if (route.request().headers().accept === 'application/vnd.fluo.react-navigation+json;v=2') {
      await deferred;
    }
    await route.continue();
  });
  const requestStarted = page.waitForRequest((request) =>
    new URL(request.url()).pathname === '/search'
    && request.headers().accept === 'application/vnd.fluo.react-navigation+json;v=2',
  { timeout: 10_000 });
  const click = page.getByRole('link', { name: 'Search catalog' }).first().click();
  try {
    await requestStarted;

    // When: the new page is still unapproved.
    // Then: the previous page and shell are usable and its page head is unchanged.
    // The navigation announcer is separate from independent form status outputs.
    await expect(page.locator('[aria-live="polite"]:not([data-form-state])')).toHaveText('Loading page');
    await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
    await expect(page).toHaveTitle('Catalog item sku-42');
    await expect(page).toHaveURL(/\/products\/sku-42\?preview=true$/u);
    await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
  } finally {
    release();
  }
  await click;
  await expect(page.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  await expect(page).toHaveTitle('Search: catalog');
  await expect(page.locator('meta[name="description"]')).toHaveAttribute('content', 'Search catalog');
  await expect(page.locator('link[rel="canonical"]')).toHaveCount(0);
  await expect(page.locator('link[data-vite-style]')).toHaveCount(1);
  await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
});

test('resets a throwing approved page locally without a second request', async ({ page }) => {
  // Given: the HTTP-approved destination throws only after client rendering starts.
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
  await page.getByRole('button', { name: 'Shell taps: 0' }).click();
  await page.evaluate(() => { document.documentElement.dataset.starterIdentity = 'retained'; });
  let approvals = 0;
  page.on('response', (response) => {
    if (new URL(response.url()).pathname === '/products/render-error'
      && response.request().headers().accept === 'application/vnd.fluo.react-navigation+json;v=2') {
      approvals++;
    }
  });
  const approved = page.waitForResponse((response) =>
    new URL(response.url()).pathname === '/products/render-error'
    && response.request().headers().accept === 'application/vnd.fluo.react-navigation+json;v=2');

  // When: the user locally resets the already-approved page after a React render error.
  await page.getByRole('link', { name: 'Open throwing page' }).click();
  expect((await approved).status()).toBe(200);
  await expect(page.getByRole('alert', { name: 'Page rendering failed' })).toBeVisible();
  await expect(page).toHaveURL(/\/products\/render-error$/u);
  await expect(page).toHaveTitle('Catalog item render-error');
  await page.evaluate(() => { Reflect.set(window, '__allowRenderRetry', true); });
  await page.getByRole('button', { name: 'Try rendering this page again' }).click();

  // Then: the destination, shell and document survive with no fresh HTTP approval.
  await expect(page.getByRole('heading', { name: 'Catalog item render-error' })).toBeVisible();
  await expect(page.getByRole('button', { name: 'Shell taps: 1' })).toBeVisible();
  expect(await page.evaluate(() => document.documentElement.dataset.starterIdentity)).toBe('retained');
  expect(approvals).toBe(1);
});

const NAVIGATION_MEDIA_TYPE = 'application/vnd.fluo.react-navigation+json;v=2';

test('refreshes the same page without remounting the generated shell or adding history', async ({ page }) => {
  // Given: an interactive page with page-local state and a persistent shell resource.
  const diagnostics: string[] = [];
  page.on('pageerror', (error) => diagnostics.push(error.message));
  await page.goto('/products/sku-42?preview=true');
  const counter = page.getByRole('button', { name: 'Count: 0', exact: true });
  await expect(counter).toBeEnabled();
  await counter.click();
  await page.getByRole('button', { name: 'Use shell resource' }).click();
  const ack = await page.getByTestId('resource-ack').textContent();
  const before = await page.evaluate(() => ({
    href: location.href, historyLength: history.length, resourceId: window.__reactResource?.id,
  }));
  const changed = await page.request.post('/products/sku-42', {
    data: { name: 'Updated outside the page' },
    maxRedirects: 0,
  });
  expect(changed.status()).toBe(303);
  await expect(page.getByTestId('product-name')).toHaveText('Current product: Catalog item sku-42');
  let release = () => {};
  const held = new Promise<void>((resolve) => { release = resolve; });
  let started = () => {};
  const requested = new Promise<void>((resolve) => { started = resolve; });
  await page.route('**/products/sku-42?preview=true', async (route) => {
    if (route.request().headers().accept !== NAVIGATION_MEDIA_TYPE) return route.continue();
    started();
    await held;
    return route.continue();
  });
  const approved = page.waitForResponse((response) => response.request().headers().accept === NAVIGATION_MEDIA_TYPE
    && new URL(response.url()).pathname === '/products/sku-42');

  // When: current-page approval is held, then released.
  await page.getByRole('button', { name: 'Refresh current page' }).click();
  await requested;
  await expect(page.getByLabel('Navigation status')).toHaveText('refreshing (refresh)');
  await expect(page.getByRole('button', { name: 'Count: 1', exact: true })).toBeVisible();
  await expect(page.getByTestId('product-name')).toHaveText('Current product: Catalog item sku-42');
  release();
  expect((await approved).status()).toBe(200);

  // Then: the page resets only after approval, while URL/history and shell survive.
  await expect(page.getByLabel('Navigation status')).toHaveText('complete (refresh)');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeVisible();
  await expect(page.getByTestId('product-name')).toHaveText('Current product: Updated outside the page');
  expect(await page.evaluate(() => ({
    href: location.href, historyLength: history.length, resourceId: window.__reactResource?.id,
  }))).toEqual(before);
  await page.getByRole('button', { name: 'Use shell resource' }).click();
  expect(await page.getByTestId('resource-ack').textContent()).not.toBe(ack);
  expect(await page.evaluate(() => window.__reactResourceStats)).toEqual({ mounts: 1, cleanups: 0 });
  expect(diagnostics).toEqual([]);
});

test('keeps native POST, 303 and GET usable without client JavaScript', async ({ baseURL, browser }) => {
  // Given: a generated product page served to a JavaScript-disabled browser.
  if (baseURL === undefined) throw new TypeError('The browser fixture requires a base URL.');
  const pathname = '/products/sku-native-3873';
  const context = await browser.newContext({ baseURL, javaScriptEnabled: false });
  const page = await context.newPage();
  try {
    const initial = await page.goto(`${pathname}?preview=true`);
    expect(initial?.status()).toBe(200);
    await expect(page.getByTestId('product-name')).toHaveText('Current product: Catalog item sku-native-3873');
    await page.getByRole('textbox', { name: 'Product name' }).fill('Updated without scripts');
    const redirected = page.waitForResponse((response) =>
      response.request().method() === 'POST'
      && new URL(response.url()).pathname === pathname);

    // When: the actual HTML form submits without hydration or client JavaScript.
    await page.getByRole('button', { name: 'Save product' }).click();
    const response = await redirected;

    // Then: the HTTP-owned redirect obtains a new document with the changed server value.
    expect(response.status()).toBe(303);
    expect(response.headers().location).toBe(pathname);
    await expect(page).toHaveURL(/\/products\/sku-native-3873$/u);
    await expect(page.getByTestId('product-name')).toHaveText('Current product: Updated without scripts');
  } finally {
    await context.close();
  }
});

test('preserves a generated page on refresh error and retries a fresh approval', async ({ page }) => {
  // Given: a transient failure on the current page's negotiated GET.
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
  await page.route('**/products/sku-42?preview=true', (route) =>
    route.request().headers().accept === NAVIGATION_MEDIA_TYPE
      ? route.fulfill({ status: 503, body: 'private failure' }) : route.continue());
  const denied = page.waitForResponse((response) => response.status() === 503
    && response.request().headers().accept === NAVIGATION_MEDIA_TYPE);

  // When: refresh fails and the persistent shell retries after the failure is removed.
  await page.getByRole('button', { name: 'Refresh current page' }).click();
  await denied;
  await expect(page.getByRole('alert')).toContainText('server-error');
  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
  await page.unrouteAll();
  const approved = page.waitForResponse((response) => response.status() === 200
    && response.request().headers().accept === NAVIGATION_MEDIA_TYPE
    && new URL(response.url()).pathname === '/products/sku-42');
  await page.getByRole('button', { name: 'Retry navigation' }).click();
  await approved;

  // Then: the new approval ends error state without replacing the shell resource.
  await expect(page.getByRole('alert')).toHaveCount(0);
  await expect(page.getByLabel('Navigation status')).toHaveText('complete (refresh)');
  expect(await page.evaluate(() => window.__reactResourceStats)).toEqual({ mounts: 1, cleanups: 0 });
});

declare global {
  interface Window {
    __originalResource?: Window['__reactResource'];
    __reactResource?: { readonly id: string; operate: () => string };
    __reactResourceStats?: { mounts: number; cleanups: number };
  }
}

for (const reason of ['network', 'server-error'] as const) {
  test(`preserves the generated shell resource across ${reason} and fresh retry`, async ({ page }) => {
    // Given: the HTTP-selected page has hydrated and the shell resource has acknowledged work.
    const diagnostics: string[] = [];
    page.on('pageerror', (error) => diagnostics.push(error.message));
    await page.goto('/products/sku-42?preview=true');
    await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
    await expect(page.getByRole('button', { name: 'Use shell resource' })).toBeVisible();
    await page.getByRole('button', { name: 'Use shell resource' }).click();
    const firstAck = await page.getByTestId('resource-ack').textContent();
    await page.evaluate(() => {
      window.__originalResource = window.__reactResource;
      document.documentElement.dataset.shellIdentity = 'approved';
    });
    const destination = '/search?q=catalog';
    await page.route((url) => `${url.pathname}${url.search}` === destination, (route) => {
      if (route.request().headers().accept !== NAVIGATION_MEDIA_TYPE) return route.continue();
      return reason === 'network' ? route.abort('failed') : route.fulfill({ status: 503, body: 'private server trace' });
    });
    const rejected = reason === 'network'
      ? page.waitForEvent('requestfailed', (request) => new URL(request.url()).pathname === '/search'
        && request.headers().accept === NAVIGATION_MEDIA_TYPE)
      : page.waitForResponse((response) => response.status() === 503
        && new URL(response.url()).pathname === '/search'
        && response.request().headers().accept === NAVIGATION_MEDIA_TYPE);

    // When: a negotiated request fails, then the user retries after removing the failure.
    await page.getByRole('link', { name: 'Search catalog' }).first().click();
    await rejected;
    await expect(page.getByRole('alert')).toContainText(`Navigation failed: ${reason}`);
    await expect(page).toHaveURL(/\/products\/sku-42\?preview=true$/u);
    await expect(page.getByLabel('Current route')).toContainText('/products/sku-42?preview=true ({"sku":"sku-42"})');
    await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
    await page.getByRole('button', { name: 'Use shell resource' }).click();
    const secondAck = await page.getByTestId('resource-ack').textContent();
    expect(secondAck).not.toBe(firstAck);
    expect(await page.evaluate(() => window.__originalResource === window.__reactResource)).toBe(true);
    await page.unrouteAll();
    const approved = page.waitForResponse((response) => new URL(response.url()).pathname === '/search'
      && response.request().headers().accept === NAVIGATION_MEDIA_TYPE);
    await page.getByRole('button', { name: 'Retry navigation' }).click();
    expect((await approved).status()).toBe(200);

    // Then: the approved destination alone changes and the same resource still acknowledges work.
    await expect(page).toHaveURL(/\/search\?q=catalog$/u);
    await expect(page.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
    await expect(page.getByRole('alert')).toHaveCount(0);
    expect(await page.evaluate(() => document.documentElement.dataset.shellIdentity)).toBe('approved');
    expect(await page.evaluate(() => window.__originalResource === window.__reactResource)).toBe(true);
    await page.getByRole('button', { name: 'Use shell resource' }).click();
    expect(await page.getByTestId('resource-ack').textContent()).not.toBe(secondAck);
    expect(await page.evaluate(() => window.__reactResourceStats)).toEqual({ mounts: 1, cleanups: 0 });
    expect(diagnostics).toEqual([]);
  });
}

test('retains the approved shell after a mapped page import fails until explicit document exit', async ({ page }) => {
  test.skip(['dev', 'direct'].includes(process.env.FLUO_REACT_STARTER_SERVER_COMMAND ?? ''),
    'Build-mapped chunks are only served by the production browser.');
  const errors: string[] = [];
  page.on('pageerror', (error) => errors.push(error.message));
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
  await expect(page.getByRole('button', { name: 'Use shell resource' })).toBeVisible();
  await page.getByRole('button', { name: 'Use shell resource' }).click();
  const firstAck = await page.getByTestId('resource-ack').textContent();
  expect(firstAck).toMatch(/:[1-9]\d*$/u);
  await page.evaluate(() => {
    window.__originalResource = window.__reactResource;
    document.documentElement.dataset.shellIdentity = 'approved';
  });
  await page.route((url) => /\/assets\/page-search-[^/]+\.js$/u.test(url.pathname),
    (route) => route.abort('failed'));
  const failedChunk = page.waitForEvent('requestfailed', (request) =>
    /\/assets\/page-search-[^/]+\.js$/u.test(new URL(request.url()).pathname));
  const approved = page.waitForResponse((response) => new URL(response.url()).pathname === '/search'
    && response.request().headers().accept === NAVIGATION_MEDIA_TYPE);

  await page.getByRole('link', { name: 'Search catalog' }).first().click();
  expect((await approved).status()).toBe(200);
  await failedChunk;
  await expect(page.getByRole('alert')).toContainText('import-failure');
  await expect(page).toHaveURL(/\/products\/sku-42\?preview=true$/u);
  await expect(page.getByLabel('Current route')).toContainText('/products/sku-42?preview=true ({"sku":"sku-42"})');
  await expect(page.getByRole('heading', { name: 'Catalog item sku-42' })).toBeVisible();
  expect(await page.evaluate(() => document.documentElement.dataset.shellIdentity)).toBe('approved');
  expect(await page.evaluate(() => window.__originalResource === window.__reactResource)).toBe(true);
  await page.getByRole('button', { name: 'Use shell resource' }).click();
  expect(await page.getByTestId('resource-ack').textContent()).not.toBe(firstAck);
  expect(await page.evaluate(() => window.__reactResourceStats)).toEqual({ mounts: 1, cleanups: 0 });
  expect(errors).toEqual([]);

  await page.unrouteAll();
  const ordinaryDocument = page.waitForRequest((request) => new URL(request.url()).pathname === '/search'
    && request.headers().accept !== NAVIGATION_MEDIA_TYPE);
  await page.getByRole('button', { name: 'Open full document' }).click();
  await ordinaryDocument;
  await expect(page).toHaveURL(/\/search\?q=catalog$/u);
  await expect(page.getByRole('heading', { name: 'Search: catalog' })).toBeVisible();
  expect(await page.evaluate(() => document.documentElement.dataset.shellIdentity)).toBeUndefined();
});

test('a failed replace commits no unapproved URL or params and explicit document exit remains available', async ({ page }) => {
  await page.goto('/products/sku-42?preview=true');
  await expect(page.getByRole('button', { name: 'Count: 0', exact: true })).toBeEnabled();
